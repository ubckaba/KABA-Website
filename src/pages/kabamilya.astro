<YearSwitcher/>
</div>

<div id="team-2627" data-team
  class="xl:px-60 sm:px-8 px-2 lg:py-12 pb-8 lg:space-y-24 space-y-8">
  <TeamSections/>
</div>

<div id="team-2526" data-team
  class="hidden xl:px-60 sm:px-8 px-2 lg:py-12 pb-8 lg:space-y-24 space-y-8">
