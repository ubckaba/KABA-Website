---
import Layout from '../layouts/Layout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SectionBody from '../components/SectionBody.astro';
import PageBody from '../components/PageBody.astro';
import PageTitle from '../components/PageTitle.astro';
import { getCollection } from 'astro:content';

const episodes: any[] = await getCollection('kabatalks' as any);
---

<Layout>
	<div class="xl:px-50 sm:px-4 px-0 lg:pt-24 pt-16 lg:pb-12 pb-8 space-y-2 lg:space-y-4">
		<PageTitle title="KABATALKS"/>
		<PageBody descrip="HELLO!!! We’re Soffia and Princess, and we’re so excited to be your Cultural Directors and podcast hosts for KABATALKS this year! 🎙️🇵🇭 KABATALKS is a podcast dedicated to exploring Filipino themes and how they connect to our everyday lives. We’re looking forward to sharing our discussions, random thoughts, and silly antics with you all. Thanks for tuning in, and we hope you enjoy listening! 💗"/>
	</div>

	<div class="xl:px-60 sm:px-8 px-2 lg:py-12 pb-8 lg:space-y-24 space-y-8">
		<!-- Page content goes here -->

		{episodes.map(episode => (
			<div class="lg:space-y-4 space-y-2">
				<SectionTitle title={episode.data.title}/>
				<GalleryCard text="WATCH THE PODCAST ON YOUTUBE!" cover={episode.data.cover} image1={episode.data.image1} image2={episode.data.image2} link={episode.data.link}/>
				<SectionBody descrip={episode.data.description}/>
			</div>
		))}

	</div>
</Layout>
