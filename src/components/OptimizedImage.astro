---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { src, alt = '', width = 800, class: className = '', eager = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}',
  { eager: true }
);

const clean = String(src).replace(/^\//, '');
const photo = images[`/src/assets/${clean}`]?.default;
---

{photo ? (
  <Image src={photo} alt={alt} width={width} class={className}
    loading={eager ? 'eager' : 'lazy'} />
) : (
  <img src={`/${clean}`} alt={alt} class={className}
    loading={eager ? 'eager' : 'lazy'} decoding="async" />
)}